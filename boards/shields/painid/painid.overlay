// GPIO index mapping (verified from PCB traces):
//  idx  0 = Col1  -> pro_micro pin 15 (P1.06)
//  idx  1 = Col2  -> pro_micro pin 14 (P1.04)
//  idx  2 = Col3  -> pro_micro pin 10 (P0.11)
//  idx  3 = Col4  -> pro_micro pin  9 (P1.00)
//  idx  4 = Col5  -> pro_micro pin  8 (P0.24)
//  idx  5 = Col6  -> pro_micro pin  7 (P0.22)
//  idx  6 = Col7  -> pro_micro pin  1 (P0.06)
//  idx  7 = Col8  -> pro_micro pin  2 (P0.08)
//  idx  8 = Col9  -> pro_micro pin  5 (P0.17)
//  idx  9 = Col10 -> pro_micro pin  6 (P0.20)
//  idx 10 = Row1  -> pro_micro pin 22 (P1.11)
//  idx 11 = Row2  -> pro_micro pin 21 (P1.13)
//  idx 12 = Row3  -> pro_micro pin 20 (P1.15)
//  idx 13 = Row4  -> pro_micro pin 19 (P0.02)
//  idx 14 = Row5  -> pro_micro pin 18 (P0.29)
//  idx 15 = Row6  -> pro_micro pin 17 (P0.31)

#include <dt-bindings/zmk/matrix_transform.h>

#include "painid-layouts.dtsi"

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };

    kscan: kscan {
        compatible = "zmk,kscan-gpio-charlieplex";
        wakeup-source;

        gpios
            = <&pro_micro 15 GPIO_ACTIVE_HIGH>   /* idx  0 = Col1  */
            , <&pro_micro 14 GPIO_ACTIVE_HIGH>   /* idx  1 = Col2  */
            , <&pro_micro 10 GPIO_ACTIVE_HIGH>   /* idx  2 = Col3  */
            , <&pro_micro 9  GPIO_ACTIVE_HIGH>   /* idx  3 = Col4  */
            , <&pro_micro 8  GPIO_ACTIVE_HIGH>   /* idx  4 = Col5  */
            , <&pro_micro 7  GPIO_ACTIVE_HIGH>   /* idx  5 = Col6  */
            , <&pro_micro 1  GPIO_ACTIVE_HIGH>   /* idx  6 = Col7  */
            , <&pro_micro 2  GPIO_ACTIVE_HIGH>   /* idx  7 = Col8  */
            , <&pro_micro 5  GPIO_ACTIVE_HIGH>   /* idx  8 = Col9  */
            , <&pro_micro 6  GPIO_ACTIVE_HIGH>   /* idx  9 = Col10 */
            , <&pro_micro 22 GPIO_ACTIVE_HIGH>   /* idx 10 = Row1  */
            , <&pro_micro 21 GPIO_ACTIVE_HIGH>   /* idx 11 = Row2  */
            , <&pro_micro 20 GPIO_ACTIVE_HIGH>   /* idx 12 = Row3  */
            , <&pro_micro 19 GPIO_ACTIVE_HIGH>   /* idx 13 = Row4  */
            , <&pro_micro 18 GPIO_ACTIVE_HIGH>   /* idx 14 = Row5  */
            , <&pro_micro 17 GPIO_ACTIVE_HIGH>   /* idx 15 = Row6  */
            ;
    };

    default_transform: default_transform {
        compatible = "zmk,matrix-transform";
        columns = <16>;
        rows = <16>;

        map = <
            /* Row 1 - Function row: Esc F1-F12 PrtSc ScrLk Pause */
            RC(1,10)  RC(10,1)  RC(2,10)  RC(10,2)  RC(3,10)  RC(10,3)  RC(4,10)  RC(10,4)
            RC(5,10)  RC(10,5)  RC(6,10)  RC(10,6)  RC(7,10)  RC(10,7)  RC(8,10)  RC(10,8)

            /* Row 2 - Number row: Enc ^ 1-0 ß ´ Bspc | Ins Home PgUp | NumLk / * - */
            RC(0,11)  RC(11,0)  RC(1,11)  RC(11,1)  RC(2,11)  RC(11,2)  RC(3,11)  RC(11,3)
            RC(4,11)  RC(11,4)  RC(5,11)  RC(11,5)  RC(6,11)  RC(11,6)  RC(7,11)  RC(11,7)
            RC(8,11)  RC(11,8)  RC(9,11)  RC(11,9)  RC(9,10)  RC(10,9)

            /* Row 3 - QWERTY: Enc Tab Q-Ü + Enter | Del End PgDn | 7 8 9 + */
            RC(0,12)  RC(12,0)  RC(1,12)  RC(12,1)  RC(2,12)  RC(12,2)  RC(3,12)  RC(12,3)
            RC(4,12)  RC(12,4)  RC(5,12)  RC(12,5)  RC(6,12)  RC(12,6)  RC(7,12)  RC(12,7)
            RC(8,12)  RC(12,8)  RC(9,12)  RC(12,9)  RC(9,13)  RC(13,9)

            /* Row 4 - Home row: Enc Caps A-# | 4 5 6 */
            RC(0,13)  RC(1,13)  RC(13,1)  RC(2,13)  RC(13,2)  RC(3,13)  RC(13,3)  RC(4,13)
            RC(13,4)  RC(5,13)  RC(13,5)  RC(6,13)  RC(13,6)  RC(7,13)  RC(13,7)  RC(8,13)
            RC(13,8)

            /* Row 5 - Shift row: Enc Shift < Y-Shift Up | 1 2 3 Enter */
            RC(0,14)  RC(14,0)  RC(1,14)  RC(14,1)  RC(2,14)  RC(14,2)  RC(3,14)  RC(14,3)
            RC(4,14)  RC(14,4)  RC(5,14)  RC(14,5)  RC(6,14)  RC(14,6)  RC(7,14)  RC(14,7)
            RC(8,14)  RC(14,8)  RC(9,14)

            /* Row 6 - Bottom row: Enc Ctrl Win Alt Space AltGr Win Menu Ctrl ← ↓ → | 0 . */
            RC(0,15)  RC(15,0)  RC(1,15)  RC(15,1)  RC(3,15)  RC(4,15)  RC(15,4)  RC(5,15)
            RC(15,5)  RC(6,15)  RC(7,15)  RC(15,7)  RC(8,15)  RC(15,8)
        >;
    };
};
