#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include "keys_de.h"

/ {
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
                /* Row 1 - Function row: Esc F1 F2 F3 F4 F5 F6 F7 F8 F9 F10 F11 F12 PrtSc ScrLk Pause */
                &kp ESC        &kp F1          &kp F2          &kp F3          &kp F4         &kp F5
                &kp F6         &kp F7          &kp F8          &kp F9          &kp F10        &kp F11
                &kp F12        &kp PSCRN       &kp SLCK        &kp PAUSE_BREAK

                /* Row 2 - Number row: Enc(rot=C_MUTE) ^ 1 2 3 4 5 6 7 8 9 0 ß ´ Bspc Ins Home PgUp NumLk / * Num- */
                &kp C_MUTE     &kp DE_CARET    &kp DE_N1       &kp DE_N2       &kp DE_N3      &kp DE_N4
                &kp DE_N5      &kp DE_N6       &kp DE_N7       &kp DE_N8       &kp DE_N9      &kp DE_N0
                &kp DE_SHARP_S &kp DE_ACUTE    &kp BSPC        &kp INS         &kp HOME       &kp PAGE_UP
                &kp LNLCK      &kp SLASH       &kp KP_MULTIPLY &kp MINUS

                /* Row 3 - QWERTY: Enc(rot=F24) Tab Q W E R T Z U I O P Ü + Enter Del End PgDn Num7 Num8 Num9 Num+ */
                &kp F24        &kp TAB         &kp DE_Q        &kp DE_W        &kp DE_E       &kp DE_R
                &kp DE_T       &kp DE_Z        &kp DE_U        &kp DE_I        &kp DE_O       &kp DE_P
                &kp DE_U_UMLAUT &kp DE_PLUS    &kp ENTER       &kp DEL         &kp END        &kp PG_DN
                &kp KP_NUMBER_7 &kp KP_NUMBER_8 &kp KP_NUMBER_9 &kp PLUS

                /* Row 4 - Home row: Enc(rot=F23) Caps A S D F G H J K L Ö Ä # Num4 Num5 Num6 */
                &kp F23        &kp CAPSLOCK    &kp DE_A        &kp DE_S        &kp DE_D       &kp DE_F
                &kp DE_G       &kp DE_H        &kp DE_J        &kp DE_K        &kp DE_L       &kp DE_O_UMLAUT
                &kp DE_A_UMLAUT &kp DE_HASH    &kp KP_NUMBER_4 &kp KP_NUMBER_5 &kp KP_NUMBER_6

                /* Row 5 - Shift row: Enc(rot=C_NEXT) LShift < Y X C V B N M , . - RShift Up EncBtn EncBtn Num3 NumEnter */
                &kp C_NEXT     &kp LSHIFT      &kp DE_LESS_THAN &kp DE_Y       &kp DE_X       &kp DE_C
                &kp DE_V       &kp DE_B        &kp DE_N        &kp DE_M        &kp DE_COMMA   &kp DE_PERIOD
                &kp DE_MINUS   &kp RSHIFT      &kp UP          &kp C_MUTE      &kp C_MUTE
                &kp KP_NUMBER_3 &kp ENTER

                /* Row 6 - Bottom row: Enc(rot=C_PLAY_PAUSE) LCtrl LWin LAlt Space RAlt RWin Menu RCtrl Left Down Right Num0 Num. */
                &kp C_PLAY_PAUSE &kp LCTRL     &kp LWIN        &kp LALT        &kp SPACE      &kp RALT
                &trans         &kp RWIN        &kp RCTRL       &kp LEFT        &kp DOWN       &kp RIGHT
                &kp KP_NUMBER_0 &kp COMMA
            >;
        };
    };
};
